---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { SITE } from '../consts';
import { formatDateShort } from '../utils/formatDate';

const posts = (
  await getCollection('posts', ({ data }) => !data.draft)
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const byYear = new Map<number, typeof posts>();
for (const post of posts) {
  const year = post.data.date.getFullYear();
  const group = byYear.get(year) ?? [];
  group.push(post);
  byYear.set(year, group);
}
const years = [...byYear.entries()];
---

<BaseLayout title={SITE.title} description={SITE.description}>
  <header class="home-hero">
    <h1>
      写点东西，<span class="accent">留给自己</span>，
      也留给路过的人。
    </h1>
    <p>
      {SITE.description}这里没有算法推荐，只有按时间倒序排列的文章。
    </p>
  </header>

  <section class="archive" aria-label="文章列表">
    {
      years.map(([year, group]) => (
        <div class="year-group">
          <h2 class="year-label">{year}</h2>
          <ol class="post-list">
            {
              group.map((post) => (
                <li class="post-row">
                  <a href={`/posts/${post.slug}/`}>
                    <time datetime={post.data.date.toISOString()}>
                      {formatDateShort(post.data.date)}
                    </time>
                    <div>
                      <h3>{post.data.title}</h3>
                      <p>{post.data.description}</p>
                      {
                        post.data.tags.length > 0 && (
                          <ul class="tag-list">
                            {post.data.tags.map((tag) => (
                              <li>
                                <span class="tag">#{tag}</span>
                              </li>
                            ))}
                          </ul>
                        )
                      }
                    </div>
                  </a>
                </li>
              ))
            }
          </ol>
        </div>
      ))
    }
  </section>
</BaseLayout>
