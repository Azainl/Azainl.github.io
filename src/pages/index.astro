---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, PER_PAGE } from '../consts';
import { getPublishedPosts, getFeaturedPosts } from '../utils/posts';
import Archive from '../components/Archive.astro';
import { url } from '../utils/url';
import { tagSlug, usedTagGroups } from '../data/tags';
import { formatDate } from '../utils/formatDate';

const posts = await getPublishedPosts();

// 精选不再单独成块：它在列表里以「推荐」标记出现。
// 之前「精选文章」是一个独立列表，同一篇文章会同时出现在精选和最近文章里，
// 首页第一屏因此重复展示同一内容；标记进列表后重复消失，也不再多出一组卡片。
const featured = getFeaturedPosts(posts, 3).map((post) => post.slug);

// 报头用真实数据代替又一段自我介绍（列表是倒序的，末位即最早一篇）
const earliest = posts[posts.length - 1];

// 主题入口：沿用「内容领域」的分组，但收成导航行而不是四张一样的卡片。
// 卡片把导航伪装成内容，还占掉一屏；标签本来就是要人点走的入口。
const tagCounts = new Map<string, number>();
for (const post of posts) {
  for (const tag of post.data.tags) {
    tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
  }
}
const usedTags = new Set(tagCounts.keys());
const groups = usedTagGroups(usedTags);

const base = url('/');
---

<BaseLayout title={SITE.title} description={SITE.description}>
  <header class="masthead">
    <h1 class="reveal">写代码，读书，过日子。</h1>
    <p class="reveal" style="--reveal-delay: 60ms">
      这个博客按时间倒序排列，没有算法推荐。目前 {posts.length} 篇，
      最早一篇写于 {formatDate(earliest.data.date)}。
    </p>
  </header>

  <section class="home-block" aria-labelledby="posts-heading">
    <h2 class="home-block-title reveal" id="posts-heading" style="--reveal-delay: 120ms">
      文章
    </h2>
    <Archive posts={posts} page={1} perPage={PER_PAGE} featured={featured} riseBase={180} />
  </section>

  {
    groups.length > 0 && (
      <nav class="home-block home-topics" aria-labelledby="topics-heading">
        <h2 class="home-block-title reveal" id="topics-heading">按主题</h2>
        <dl class="topic-rows reveal">
          {groups.map((group) => (
            <div class="topic-row">
              <dt>{group.name}</dt>
              <dd>
                <ul class="tag-list">
                  {group.tags.map((tag) => (
                    <li>
                      <a class="tag" href={url(`/tags/${tagSlug(tag)}/`)}>
                        #{tag}
                        <span class="count">{tagCounts.get(tag)}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </dd>
            </div>
          ))}
        </dl>
        <p class="topic-all reveal">
          <a href={url('/tags/')}>全部 {tagCounts.size} 个主题</a>
        </p>
      </nav>
    )
  }

  <p class="colophon reveal">
    关于这个博客和它的作者，见<a href={url('/about/')}>关于页</a>；
    想跟进新文章可以订阅<a href={url('/rss.xml')}>RSS</a>。
  </p>
</BaseLayout>

<script is:inline define:vars={{ base }}>
  // 兼容旧书签 / 外链里的 ?page=N 写法，统一重定向到静态分页地址 /page/N/
  (() => {
    const p = new URLSearchParams(location.search).get('page');
    const n = p ? parseInt(p, 10) : NaN;
    if (Number.isFinite(n) && n > 1) {
      location.replace(base + 'page/' + n + '/');
    } else if (p) {
      history.replaceState(null, '', location.pathname);
    }
  })();
</script>
