---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { SITE } from '../consts';
import { formatDateShort } from '../utils/formatDate';
import { vtName } from '../utils/vtName';

const posts = (
  await getCollection('posts', ({ data }) => !data.draft)
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// 每页文章数（首页翻页）
const POSTS_PER_PAGE = 4;
const totalPages = Math.max(1, Math.ceil(posts.length / POSTS_PER_PAGE));

const pageOf = new Map<string, number>();
posts.forEach((post, i) => {
  pageOf.set(post.id, Math.floor(i / POSTS_PER_PAGE) + 1);
});

const byYear = new Map<number, typeof posts>();
for (const post of posts) {
  const year = post.data.date.getFullYear();
  const group = byYear.get(year) ?? [];
  group.push(post);
  byYear.set(year, group);
}
const years = [...byYear.entries()];

const yearGroupReveal = (index: number) =>
  `--reveal-delay: ${Math.min(index * 80, 320)}ms`;
---

<BaseLayout title={SITE.title} description={SITE.description}>
  <header class="home-hero reveal">
    <h1>
      写点东西，<span class="accent">留给自己</span>，
      也留给路过的人。
    </h1>
    <p>
      {SITE.description}这里没有算法推荐，只有按时间倒序排列的文章。
    </p>
  </header>

  <section class="archive" aria-label="文章列表">
    {
      years.map(([year, group], index) => (
        <div class="year-group reveal" style={yearGroupReveal(index)}>
          <h2 class="year-label">{year}</h2>
          <ol class="post-list">
            {
              group.map((post) => (
                <li class="post-row" data-page={pageOf.get(post.id)}>
                  <a href={`/posts/${post.slug}/`}>
                    <time datetime={post.data.date.toISOString()}>
                      {formatDateShort(post.data.date)}
                    </time>
                    <div>
                      <h3 transition:name={vtName(post.slug)}>
                        {post.data.title}
                      </h3>
                      <p>{post.data.description}</p>
                    </div>
                  </a>
                  {
                    post.data.tags.length > 0 && (
                      <ul class="tag-list">
                        {post.data.tags.map((tag) => (
                          <li>
                            <a class="tag" href={`/tags/${tag}/`}>#{tag}</a>
                          </li>
                        ))}
                      </ul>
                    )
                  }
                </li>
              ))
            }
          </ol>
        </div>
      ))
    }
    <nav
      class="pagination"
      id="pagination"
      aria-label="文章翻页"
      data-total={totalPages}
      hidden
    >
      <a class="page-btn" href="?page=1" data-dir="prev">← 上一页</a>
      <ol class="page-numbers">
        {
          Array.from({ length: totalPages }, (_, i) => i + 1).map((n) => (
            <li>
              <a class="page-number" data-page={n} href={`?page=${n}`}>{n}</a>
            </li>
          ))
        }
      </ol>
      <a class="page-btn" href={`?page=${totalPages}`} data-dir="next">
        下一页 →
      </a>
    </nav>
  </section>
</BaseLayout>

<script>
  function initPagination() {
    const nav = document.getElementById('pagination');
    if (!nav || nav.dataset.inited) return;
    nav.dataset.inited = 'true';

    const archive = document.querySelector('.archive') as HTMLElement;
    const rows = [...document.querySelectorAll('.post-row[data-page]')];
    const numLinks = [...nav.querySelectorAll('.page-number')];
    const prevBtn = nav.querySelector('[data-dir="prev"]') as HTMLAnchorElement;
    const nextBtn = nav.querySelector('[data-dir="next"]') as HTMLAnchorElement;
    const total = Number(nav.dataset.total);
    let busy = false;

    function currentPage(): number {
      const raw = new URLSearchParams(window.location.search).get('page');
      const parsed = raw ? parseInt(raw, 10) : NaN;
      if (Number.isNaN(parsed)) return 1;
      return Math.min(total, Math.max(1, parsed));
    }

    function setDisabled(el: HTMLAnchorElement, disabled: boolean) {
      if (disabled) {
        el.setAttribute('aria-disabled', 'true');
        el.setAttribute('tabindex', '-1');
      } else {
        el.removeAttribute('aria-disabled');
        el.removeAttribute('tabindex');
      }
    }

    function applyPage(page: number, animate: boolean): void {
      if (busy) return;
      // 边界收敛：始终落在 1..total 之间
      const target = Math.min(total, Math.max(1, page));
      const startHeight = archive.getBoundingClientRect().height;

      if (animate) archive.classList.add('paging');
      window.setTimeout(() => {
        for (const row of rows) {
          row.hidden = Number(row.dataset.page) !== target;
        }
        for (const el of numLinks) {
          if (Number(el.dataset.page) === target) {
            el.setAttribute('aria-current', 'page');
          } else {
            el.removeAttribute('aria-current');
          }
        }
        setDisabled(prevBtn, target === 1);
        setDisabled(nextBtn, target === total);

        const url = new URL(window.location.href);
        if (target === 1) url.searchParams.delete('page');
        else url.searchParams.set('page', String(target));
        // 保留 Astro View Transitions 的 history.state（含 index），并写入当前滚动，
        // 让 Astro 自带的滚动保留（onscrollend）与返回恢复正常工作。
        window.history.replaceState(
          { ...(history.state ?? {}), scrollX: window.scrollX, scrollY: window.scrollY },
          '',
          url,
        );

        if (animate) {
          busy = true;
          // 内容高度变化时，让页脚平滑跟随（FLIP 高度过渡）
          const endHeight = archive.getBoundingClientRect().height;
          if (endHeight !== startHeight) {
            archive.style.height = `${startHeight}px`;
            archive.style.overflow = 'hidden';
            void archive.offsetHeight;
            archive.style.height = `${endHeight}px`;
          }
          const cleanup = () => {
            archive.style.height = '';
            archive.style.overflow = '';
            archive.removeEventListener('transitionend', cleanup);
            busy = false;
          };
          archive.addEventListener('transitionend', (event) => {
            if ((event as TransitionEvent).propertyName === 'height') cleanup();
          });
          requestAnimationFrame(() => archive.classList.remove('paging'));
          // 兜底超时，防止 transitionend 丢失导致按钮卡住
          window.setTimeout(cleanup, 500);
        }
      }, animate ? 180 : 0);
    }

    nav.hidden = false;
    for (const el of numLinks) {
      el.addEventListener('click', (event) => {
        event.preventDefault();
        if (!el.hasAttribute('aria-disabled')) {
          applyPage(Number(el.dataset.page), true);
        }
      });
    }
    prevBtn.addEventListener('click', (event) => {
      event.preventDefault();
      if (!prevBtn.hasAttribute('aria-disabled')) {
        applyPage(currentPage() - 1, true);
      }
    });
    nextBtn.addEventListener('click', (event) => {
      event.preventDefault();
      if (!nextBtn.hasAttribute('aria-disabled')) {
        applyPage(currentPage() + 1, true);
      }
    });
    applyPage(currentPage(), false);
  }
  document.addEventListener('astro:page-load', initPagination);
</script>
