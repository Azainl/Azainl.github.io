---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../consts';
import { getPublishedPosts } from '../utils/posts';
import Archive from '../components/Archive.astro';
import { url } from '../utils/url';

const posts = await getPublishedPosts();
const POSTS_PER_PAGE = 4;
const base = url('/');
---

<BaseLayout title={SITE.title} description={SITE.description}>
  <header class="home-hero reveal">
    <h1>
      写点东西，<span class="accent">留给自己</span>，
      也留给路过的人。
    </h1>
    <p>
      {SITE.description}这里没有算法推荐，只有按时间倒序排列的文章。
    </p>
  </header>

  <Archive posts={posts} page={1} perPage={POSTS_PER_PAGE} />
</BaseLayout>

<script is:inline define:vars={{ base }}>
  // 兼容旧书签 / 外链里的 ?page=N 写法，统一重定向到静态分页地址 /page/N/
  (() => {
    const p = new URLSearchParams(location.search).get('page');
    const n = p ? parseInt(p, 10) : 1;
    if (Number.isFinite(n) && n > 1) {
      location.replace(base + 'page/' + n + '/');
    } else if (p) {
      history.replaceState(null, '', location.pathname);
    }
  })();
</script>
