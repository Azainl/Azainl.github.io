---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../consts';
import { getPublishedPosts } from '../../utils/posts';
import Archive from '../../components/Archive.astro';

const PER_PAGE = 4;

export const getStaticPaths = (async () => {
  const PER_PAGE = 4; // getStaticPaths 在独立作用域，需本地定义
  const posts = await getPublishedPosts();
  const totalPages = Math.max(1, Math.ceil(posts.length / PER_PAGE));
  // 第 1 页是首页 /，这里只生成第 2 页及以后
  return Array.from({ length: Math.max(0, totalPages - 1) }, (_, i) => i + 2).map(
    (n) => ({
      params: { page: String(n) },
      props: { posts, totalPages },
    }),
  );
}) satisfies GetStaticPaths;

const { posts, totalPages } = Astro.props;
const current = Number(Astro.params.page);
---

<BaseLayout
  title={`文章列表 · 第 ${current} 页 · ${SITE.name}`}
  description="全部文章，按时间倒序排列。"
>
  <header class="page-head">
    <h1>文章列表</h1>
    <p>第 {current} 页，共 {totalPages} 页。按时间倒序排列。</p>
  </header>

  <Archive posts={posts} page={current} perPage={PER_PAGE} />
</BaseLayout>
