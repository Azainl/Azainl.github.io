---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE, PER_PAGE } from '../../consts';
import { getPublishedPosts, getFeaturedPosts } from '../../utils/posts';
import Archive from '../../components/Archive.astro';
import { breadcrumbList, collectionPage } from '../../utils/jsonld';

export const getStaticPaths = (async () => {
  const posts = await getPublishedPosts();
  const totalPages = Math.max(1, Math.ceil(posts.length / PER_PAGE));
  // 第 1 页是首页 /，这里只生成第 2 页及以后
  return Array.from({ length: Math.max(0, totalPages - 1) }, (_, i) => i + 2).map(
    (n) => ({
      params: { page: String(n) },
      props: { posts, totalPages },
    }),
  );
}) satisfies GetStaticPaths;

const { posts, totalPages } = Astro.props;
const current = Number(Astro.params.page);

// 「推荐」标记要在文章出现的**每一处**都显示，否则精选的几篇一旦跌出第 1 页，
// 标记就在全站任何地方都看不到了（2026-09 新增 4 篇后就是这样）。
const featured = getFeaturedPosts(posts, 3).map((post) => post.id);

// 分页页此前无结构化数据。分页是同一份列表的续页，因此声明为
// CollectionPage + ItemList，并把 page/canonical 指向本页自身
// （不要把续页冒充第 1 页的重复内容）。
const perPage = PER_PAGE;
const start = (current - 1) * perPage;
const pagePosts = posts.slice(start, start + perPage);
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    collectionPage({
      name: `文章列表 · 第 ${current} 页 · ${SITE.name}`,
      description: '全部文章，按时间倒序排列。',
      path: `/page/${current}/`,
      posts: pagePosts,
      site: Astro.site,
    }),
    // 末级即当前页，按惯例不带 item（与文章页、标签页保持一致）
    breadcrumbList([{ path: '/', name: '首页' }, { name: `第 ${current} 页` }], Astro.site),
  ],
};
---

<BaseLayout
  title={`文章列表 · 第 ${current} 页 · ${SITE.name}`}
  description="全部文章，按时间倒序排列。"
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} slot="ld" />
  <header class="page-head">
    <h1>文章列表</h1>
    <p>第 {current} 页，共 {totalPages} 页。按时间倒序排列。</p>
  </header>

  <Archive posts={posts} page={current} perPage={PER_PAGE} featured={featured} />
</BaseLayout>
