---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../consts';
import { Icon } from 'astro-icon/components';
---

<BaseLayout
  title={`搜索 · ${SITE.name}`}
  description="在全部文章中检索标题、标签、摘要和正文。"
  noindex
>
  <div class="search-page">
    <div class="page-head" style="padding: 0 0 1.5rem">
      <h1>搜索</h1>
      <p>输入关键词，检索标题、标签、摘要和正文。</p>
    </div>

    <div class="search-box">
      <Icon name="magnifying-glass" />
      <input
        id="search-input"
        class="search-input"
        type="text"
        placeholder="搜索关键词……"
        autocomplete="off"
        aria-label="搜索关键词"
      />
      <button id="search-clear" class="search-clear" type="button" aria-label="清空搜索">
        <Icon name="x" />
      </button>
    </div>

    {/* 结果播报区：始终留在可访问性树中（.sr-only），因此不能用 hidden 切换。
        与页头下拉共用 announce() —— 两处都有播报，行为一致。 */}
    <p class="sr-only" id="search-announce" aria-live="polite" aria-atomic="true"></p>
    <p id="search-meta" class="search-meta" hidden></p>
    <div id="search-loading" class="search-status">
      <p>正在载入文章索引……</p>
    </div>
    <div id="search-empty" class="search-status" hidden>
      <p>输入关键词开始搜索，例如「PowerShell」「Astro」「阅读」。</p>
    </div>
    <div id="search-none" class="search-status" hidden>
      <p>没有找到相关文章，换个关键词试试？</p>
    </div>
    <div id="search-error" class="search-status" hidden>
      <p>文章索引载入失败，请刷新页面重试。</p>
    </div>
    <ol id="search-results" class="post-list" hidden></ol>
  </div>
</BaseLayout>

<script>
  import {
    announce,
    buildIndex,
    searchIndex,
    highlight,
    formatDateCn,
    snippet,
    type PostIndex,
  } from '../scripts/search';
  import { vtName } from '../utils/vtName';
  import { onPageLoad } from '../scripts/lifecycle';
  import { tagSlug } from '../data/tags';
  import { url } from '../utils/url';

  let index: PostIndex[] = [];
  let timer: number | undefined;

  function initSearch() {
    const input = document.getElementById('search-input') as HTMLInputElement;
    if (!input || input.dataset.inited) return;
    input.dataset.inited = 'true';

    const clearBtn = document.getElementById('search-clear') as HTMLButtonElement;
    const meta = document.getElementById('search-meta') as HTMLElement;
    const empty = document.getElementById('search-empty') as HTMLElement;
    const none = document.getElementById('search-none') as HTMLElement;
    const loading = document.getElementById('search-loading') as HTMLElement;
    const errorBox = document.getElementById('search-error') as HTMLElement;
    const results = document.getElementById('search-results') as HTMLOListElement;
    const announceEl = document.getElementById('search-announce');

    function render(items: ReturnType<typeof searchIndex>, query: string) {
      results.replaceChildren();
      for (const { post, contentHit } of items) {
        const li = document.createElement('li');
        li.className = 'post-row search-result-row';

        const link = document.createElement('a');
        link.href = url(`/posts/${post.slug}/`);

        const time = document.createElement('time');
        time.dateTime = post.date;
        time.textContent = formatDateCn(post.date);

        const body = document.createElement('div');
        const h3 = document.createElement('h3');
        // 与列表一致的类名：样式统一挂在 .post-row-title 上，不再依赖标签名
        h3.className = 'post-row-title';
        h3.style.viewTransitionName = vtName(post.slug);
        highlight(h3, post.title, query);

        const desc = document.createElement('p');
        highlight(desc, post.description, query);

        if (contentHit) {
          const snip = document.createElement('p');
          snip.className = 'search-snippet';
          snip.textContent = snippet(post.content, query);
          body.append(h3, desc, snip);
        } else {
          body.append(h3, desc);
        }

        const tags = document.createElement('ul');
        tags.className = 'tag-list';
        for (const tag of post.tags) {
          const item = document.createElement('li');
          const tagLink = document.createElement('a');
          tagLink.className = 'tag';
          tagLink.href = url(`/tags/${tagSlug(tag)}/`);
          tagLink.textContent = `#${tag}`;
          item.appendChild(tagLink);
          tags.appendChild(item);
        }

        link.append(time, body);
        li.append(link, tags);
        results.appendChild(li);
      }
    }

    function updateUrl(q: string) {
      const next = new URL(window.location.href);
      if (q) next.searchParams.set('q', q);
      else next.searchParams.delete('q');
      // 保留 Astro View Transitions 写入 history.state 的状态，
      // 传 null 会清空它，导致站内返回 / 滚动恢复失效
      window.history.replaceState(history.state, '', next);
    }

    function run() {
      const q = input.value.trim();
      updateUrl(q);
      clearBtn.classList.toggle('visible', q.length > 0);
      loading.hidden = true;
      errorBox.hidden = true;
      if (!q) {
        meta.hidden = true;
        results.hidden = true;
        none.hidden = true;
        empty.hidden = false;
        announce(announceEl, '');
        return;
      }
      const items = searchIndex(index, q);
      empty.hidden = true;
      if (items.length === 0) {
        meta.hidden = true;
        results.hidden = true;
        none.hidden = false;
        // 无结果也要播报，否则读屏用户不知道检索已经完成
        announce(announceEl, `没有找到与"${q}"相关的文章`);
        return;
      }
      none.hidden = true;
      meta.hidden = false;
      meta.textContent = `找到 ${items.length} 篇文章`;
      render(items, q);
      results.hidden = false;
      announce(announceEl, `找到 ${items.length} 篇文章`);
    }

    input.addEventListener('input', () => {
      window.clearTimeout(timer);
      timer = window.setTimeout(run, 120);
    });
    input.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        input.value = '';
        run();
        input.focus();
      }
    });
    clearBtn.addEventListener('click', () => {
      input.value = '';
      run();
      input.focus();
    });

    buildIndex()
      .then((data) => {
        index = data;
        const initial = new URLSearchParams(window.location.search).get('q') ?? '';
        if (initial) {
          input.value = initial;
          run();
        } else {
          loading.hidden = true;
          empty.hidden = false;
        }
      })
      .catch(() => {
        // 索引拉取失败（离线 / 网络问题）时给出明确反馈，而不是一直卡在「正在载入」
        loading.hidden = true;
        errorBox.hidden = false;
        announce(announceEl, '文章索引载入失败，请刷新页面重试');
      });
  }

  onPageLoad(initSearch);
</script>
