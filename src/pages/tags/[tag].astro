---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../consts';
import { formatDateShort } from '../../utils/formatDate';
import { tagDescription, tagSlug } from '../../data/tags';
import { vtName } from '../../utils/vtName';
import { url } from '../../utils/url';
import { getPublishedPosts } from '../../utils/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const tags = new Set(posts.flatMap((post) => post.data.tags));
  // URL 用英文 slug，展示名通过 props 传过去
  return [...tags].map((tag) => ({
    params: { tag: tagSlug(tag) },
    props: { name: tag },
  }));
}

const { name } = Astro.props;
const posts = (await getPublishedPosts()).filter((post) =>
  post.data.tags.includes(name),
);
---

<BaseLayout
  title={`#${name} · ${SITE.name}`}
  description={`标签「${name}」下的全部文章。`}
>
  <div class="page-head reveal">
    <p class="post-meta">标签</p>
    <h1>#{name}</h1>
    <p>{tagDescription(name)} · 共 {posts.length} 篇文章</p>
  </div>

  <section class="archive reveal" style="padding-top: 0; --reveal-delay: 80ms">
    <ol class="post-list">
      {
        posts.map((post) => (
          <li class="post-row">
            <a href={url(`/posts/${post.slug}/`)}>
              <time datetime={post.data.date.toISOString()}>
                {formatDateShort(post.data.date)}
              </time>
              <div>
                <h3 transition:name={vtName(post.slug)}>
                  {post.data.title}
                </h3>
                <p>{post.data.description}</p>
              </div>
            </a>
            {
              post.data.tags.length > 0 && (
                <ul class="tag-list">
                  {post.data.tags.map((t) => (
                    <li>
                      <a
                        class={`tag${t === name ? ' tag-current' : ''}`}
                        href={url(`/tags/${tagSlug(t)}/`)}
                      >
                        #{t}
                      </a>
                    </li>
                  ))}
                </ul>
              )
            }
          </li>
        ))
      }
    </ol>
    <p class="back-row">
      <a class="back-link" href={url('/tags/')}>← 全部标签</a>
    </p>
  </section>
</BaseLayout>
