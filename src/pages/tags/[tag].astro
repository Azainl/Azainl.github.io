---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../consts';
import { Icon } from 'astro-icon/components';
import { formatDateShort } from '../../utils/formatDate';
import { tagDescription, tagSlug } from '../../data/tags';
import { vtName } from '../../utils/vtName';
import { url } from '../../utils/url';
import { getPublishedPosts } from '../../utils/posts';
import { breadcrumbList, collectionPage } from '../../utils/jsonld';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const tags = new Set(posts.flatMap((post) => post.data.tags));
  // URL 用英文 slug，展示名通过 props 传过去
  return [...tags].map((tag) => ({
    params: { tag: tagSlug(tag) },
    props: { name: tag },
  }));
}

const { name } = Astro.props;
const posts = (await getPublishedPosts()).filter((post) =>
  post.data.tags.includes(name),
);

// 标签页此前没有任何结构化数据（全站 22 个标签页均无）。
// 这里只声明**页面上真实存在的**聚合语义：这是一个汇集页，
// 主实体是它列出的那组文章 —— 不添加页面没有的字段。
// 构造器见 utils/jsonld.ts（与分页页、面包屑共用同一份口径）。
const tagPath = `/tags/${tagSlug(name)}/`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    collectionPage({
      name: `#${name} · ${SITE.name}`,
      description: `标签「${name}」下的全部文章。`,
      path: tagPath,
      posts,
      site: Astro.site,
    }),
    // 面包屑：首页 → 全部标签 → 当前标签（不含页面上不存在的层级）
    breadcrumbList(
      [
        { path: '/', name: '首页' },
        { path: '/tags/', name: '全部标签' },
        { name: `#${name}` },
      ],
      Astro.site,
    ),
  ],
};
---

<BaseLayout
  title={`#${name} · ${SITE.name}`}
  description={`标签「${name}」下的全部文章。`}
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} slot="ld" />
  <div class="page-head reveal">
    <button
      class="post-back"
      id="back-button"
      type="button"
      aria-label="返回上一页"
    >
      <Icon name="arrow-left" size={15} />
      <span>返回</span>
    </button>
    <p class="post-meta">标签</p>
    <h1>#{name}</h1>
    <p>{tagDescription(name)} · 共 {posts.length} 篇文章</p>
  </div>

  <section class="archive reveal" style="padding-top: 0; --reveal-delay: 80ms">
    <ol class="post-list">
      {
        posts.map((post) => (
          <li class="post-row">
            <a href={url(`/posts/${post.id}/`)}>
              <time datetime={post.data.date.toISOString()}>
                {formatDateShort(post.data.date)}
              </time>
              <div>
                {/* h2 而非 h3：本页 h1 就是标签名，文章是它下面的一级。
                    原来写 h3 会形成 h1→h3 的跳级。 */}
                {/* transition:animate="none"：Astro 会为**每个**具名元素生成一整块
                    动画 CSS（约 2.4 KB，其中 keyframe 部分逐字相同，只有名字不同）。
                    实测该块在真实过渡中并不生效——具名层的动画由 effects.css 的
                    ::view-transition-old(*) 通配规则接管（实测跑的是 vt-out-forward，
                    不是 Astro 内建的 astroFadeOut）。故显式声明"不需要 Astro 生成动画"，
                    保留 name（层级必需）但去掉那块无用 CSS。 */}
                <h2 class="post-row-title" transition:name={vtName(post.id)} transition:animate="none">
                  {post.data.title}
                </h2>
                <p>{post.data.description}</p>
              </div>
            </a>
            {
              post.data.tags.length > 0 && (
                <ul class="tag-list">
                  {post.data.tags.map((t) => (
                    <li>
                      <a
                        class={`tag${t === name ? ' tag-current' : ''}`}
                        href={url(`/tags/${tagSlug(t)}/`)}
                      >
                        #{t}
                      </a>
                    </li>
                  ))}
                </ul>
              )
            }
          </li>
        ))
      }
    </ol>
    <p class="back-row">
      <a class="back-link" href={url('/tags/')}>← 全部标签</a>
    </p>
  </section>
</BaseLayout>
