---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../consts';
import { Icon } from 'astro-icon/components';
import { formatDateShort } from '../../utils/formatDate';
import { tagDescription, tagSlug } from '../../data/tags';
import { vtName } from '../../utils/vtName';
import { url } from '../../utils/url';
import { getPublishedPosts } from '../../utils/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const tags = new Set(posts.flatMap((post) => post.data.tags));
  // URL 用英文 slug，展示名通过 props 传过去
  return [...tags].map((tag) => ({
    params: { tag: tagSlug(tag) },
    props: { name: tag },
  }));
}

const { name } = Astro.props;
const posts = (await getPublishedPosts()).filter((post) =>
  post.data.tags.includes(name),
);

// 标签页此前没有任何结构化数据（全站 22 个标签页均无）。
// 这里只声明**页面上真实存在的**聚合语义：这是一个汇集页，
// 主实体是它列出的那组文章 —— 不添加页面没有的字段。
const tagUrl = new URL(url(`/tags/${tagSlug(name)}/`), Astro.site).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `#${name} · ${SITE.name}`,
  description: `标签「${name}」下的全部文章。`,
  url: tagUrl,
  inLanguage: SITE.locale,
  isPartOf: {
    '@type': 'WebSite',
    name: SITE.title,
    url: new URL('/', Astro.site).href,
  },
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: posts.length,
    itemListElement: posts.map((post, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: new URL(url(`/posts/${post.id}/`), Astro.site).href,
      name: post.data.title,
    })),
  },
};
---

<BaseLayout
  title={`#${name} · ${SITE.name}`}
  description={`标签「${name}」下的全部文章。`}
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} slot="ld" />
  <div class="page-head reveal">
    <button
      class="post-back"
      id="back-button"
      type="button"
      aria-label="返回上一页"
    >
      <Icon name="arrow-left" size={15} />
      <span>返回</span>
    </button>
    <p class="post-meta">标签</p>
    <h1>#{name}</h1>
    <p>{tagDescription(name)} · 共 {posts.length} 篇文章</p>
  </div>

  <section class="archive reveal" style="padding-top: 0; --reveal-delay: 80ms">
    <ol class="post-list">
      {
        posts.map((post) => (
          <li class="post-row">
            <a href={url(`/posts/${post.id}/`)}>
              <time datetime={post.data.date.toISOString()}>
                {formatDateShort(post.data.date)}
              </time>
              <div>
                {/* h2 而非 h3：本页 h1 就是标签名，文章是它下面的一级。
                    原来写 h3 会形成 h1→h3 的跳级。 */}
                <h2 class="post-row-title" transition:name={vtName(post.id)}>
                  {post.data.title}
                </h2>
                <p>{post.data.description}</p>
              </div>
            </a>
            {
              post.data.tags.length > 0 && (
                <ul class="tag-list">
                  {post.data.tags.map((t) => (
                    <li>
                      <a
                        class={`tag${t === name ? ' tag-current' : ''}`}
                        href={url(`/tags/${tagSlug(t)}/`)}
                      >
                        #{t}
                      </a>
                    </li>
                  ))}
                </ul>
              )
            }
          </li>
        ))
      }
    </ol>
    <p class="back-row">
      <a class="back-link" href={url('/tags/')}>← 全部标签</a>
    </p>
  </section>
</BaseLayout>
