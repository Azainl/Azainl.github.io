---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../consts';
import { Icon } from 'astro-icon/components';
import { getPublishedPosts } from '../../utils/posts';
import { tagSlug } from '../../data/tags';
import { url } from '../../utils/url';
import { breadcrumbList, safeJsonLd, tagIndexPage } from '../../utils/jsonld';

const posts = await getPublishedPosts();
const counts = new Map<string, number>();
for (const post of posts) {
  for (const tag of post.data.tags) {
    counts.set(tag, (counts.get(tag) ?? 0) + 1);
  }
}
const tags = [...counts.entries()].sort(
  (a, b) => b[1] - a[1] || a[0].localeCompare(b[0], 'zh'),
);

// 标签总览页此前是 56 个真实页里「有 canonical、未 noindex、零结构化数据」的
// 两个页面之一（另一个是 about）。这里补上聚合语义，但与标签详情页不同：
// 本页渲染的是**标签云**而不是文章列表，所以 itemListElement 填的是标签本身，
// 见 utils/jsonld.ts 的 tagIndexPage()。
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    tagIndexPage({
      name: `标签 · ${SITE.name}`,
      description: '按标签浏览全部文章。',
      path: '/tags/',
      tags: tags.map(([name, count]) => ({ name, slug: tagSlug(name), count })),
      postCount: posts.length,
      site: Astro.site,
    }),
    breadcrumbList([{ path: '/', name: '首页' }, { name: '全部标签' }], Astro.site),
  ],
};
---

<BaseLayout
  title={`标签 · ${SITE.name}`}
  description="按标签浏览全部文章。"
>
  <script type="application/ld+json" is:inline set:html={safeJsonLd(jsonLd)} slot="ld" />
  <div class="page-head reveal">
    <button
      class="post-back"
      id="back-button"
      type="button"
      aria-label="返回上一页"
    >
      <Icon name="arrow-left" size={15} />
      <span>返回</span>
    </button>
    <h1>标签</h1>
    <p>共 {posts.length} 篇文章，分布在 {tags.length} 个标签下。</p>
  </div>

  <div class="container reveal" style="padding-bottom: 5rem; --reveal-delay: 80ms">
    <ul class="tag-cloud">
      {
        tags.map(([tag, count]) => (
          <li>
            <a class="tag" href={url(`/tags/${tagSlug(tag)}/`)}>
              #{tag}<span class="count">{count}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>
