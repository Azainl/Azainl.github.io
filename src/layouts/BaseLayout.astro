---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../consts';
import { ClientRouter } from 'astro:transitions';
import { url } from '../utils/url';

// 只引入拉丁子集的可变字体，避免下载无用字符集
import geistUrl from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
import serifUrl from '@fontsource-variable/source-serif-4/files/source-serif-4-latin-wght-normal.woff2?url';

const fontFaces = `
@font-face {
  font-family: 'Geist Variable';
  font-style: normal;
  font-display: swap;
  font-weight: 100 900;
  src: url('${geistUrl}') format('woff2-variations');
}
@font-face {
  font-family: 'Source Serif 4 Variable';
  font-style: normal;
  font-display: swap;
  font-weight: 100 900;
  src: url('${serifUrl}') format('woff2-variations');
}
`;

interface Props {
  title?: string;
  description?: string;
  /** 是否为 404 页：用于跳过"路径校验"兜底刷新（见下方 ensurePageMatchesUrl） */
  notFound?: boolean;
  /** 分享卡片图的站内路径，缺省为全站默认 /og.png（由 npm run og 生成） */
  ogImage?: string;
  /**
   * 不该被收录的页面（404、站内搜索页）。会输出 `noindex`，并且
   * **不输出 canonical** —— 404 的 canonical 会指向一个并不存在的 /404/，
   * 比完全没有更糟（等于主动告诉搜索引擎去收录一个死地址）。
   */
  noindex?: boolean;
}

const {
  title = SITE.title,
  description = SITE.description,
  notFound = false,
  ogImage = '/og.png',
  noindex = false,
} = Astro.props;

// 本页自身的绝对地址：og:url 始终用它。
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
// <link rel="canonical"> 只在可收录时输出。
const canonical = noindex ? null : pageUrl;
// 注意：必须是 PNG。Facebook / Twitter / LinkedIn 都不支持 SVG 作为 og:image，
// 早先全站挂的是 public/og.svg，等于分享出去没有预览图。
const ogImageUrl = new URL(url(ogImage), Astro.site).href;
---

<!doctype html>
<html lang={SITE.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    {canonical && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href={url('/rss.xml')} />
    <link rel="preload" href={geistUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={serifUrl} as="font" type="font/woff2" crossorigin />
    {/* @font-face 必须和 preload 一起放在 head 里，否则字体声明解析晚于预加载，
        FOIT/FOUT 行为不可控 */}
    <style is:inline set:html={fontFaces}></style>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="zh_CN" />
    {/* 1200×630 的横幅卡片要用 summary_large_image，summary 会被裁成小方图 */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="theme-color" content="#f7f7f4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#131315" media="(prefers-color-scheme: dark)" />
    <ClientRouter />
    <script is:inline>
      // 首屏同步执行，避免主题闪烁（FOUC）。
      // 偏好三态：light / dark / system，未选择过则默认 system（跟随系统）。
      (() => {
        const root = document.documentElement;
        root.classList.add('js');
        const saved = localStorage.getItem('theme');
        const pref = saved === 'light' || saved === 'dark' ? saved : 'system';
        root.dataset.theme = pref;
        const dark =
          pref === 'dark' ||
          (pref === 'system' &&
            window.matchMedia('(prefers-color-scheme: dark)').matches);
        if (dark) root.classList.add('dark');

        // 兜底：`.js .reveal` 把未渐显的内容设为 opacity:0，而真正让它们显示的是
        // reveal 模块——那是外部 JS，弱网或脚本被拦截时可能永远加载不到，正文
        // 会因此**永久空白**。这里在 DOMContentLoaded 时确认模块是否已接管
        // （reveal.ts 在模块求值时就写入 data-reveal-ready），未接管就撤掉
        // `js` 标记，内容随即按"无 JS"的样式直接可见。
        // DOMContentLoaded 必定晚于模块脚本的执行或失败，故这个判据是确定的；
        // 用超时猜时机会在慢网络下误判。
        document.addEventListener('DOMContentLoaded', () => {
          if (!root.dataset.revealReady) root.classList.remove('js');
        });
      })();
    </script>
    {/* 各页面可选的 JSON-LD 结构化数据（文章页会塞 BlogPosting） */}
    <slot name="ld" />
  </head>
  <body data-path={Astro.url.pathname} data-notfound={notFound ? '' : undefined}>
    <a class="skip-link" href="#main">跳到主要内容</a>
    {/* 页头/页脚的 persist 写在它们各自的根元素上（见 Header.astro / Footer.astro）：
        transition:persist 只对**原生元素**生效，写在组件上会被静默忽略。 */}
    <Header />
    {/* main 不加 transition:name：加了会生成独立的 page-content 层，
        它同样是一对新旧快照、同样会交叉淡入 —— 等于把重影从 root 挪到了这里。
        真正需要的是"页头/页脚不闪"，那由它们自己的 persist 解决。 */}
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/reveal';
    </script>
    <script>
      import '../scripts/backButton';
    </script>
    <script>
      // 轴向/方向判定：必须在过渡开始前把 data-vt-axis 写到 <html> 上，
      // 供 effects.css 选择方向键帧（左右翻阅 vs 上下翻阅）
      import '../scripts/vtAxis';
    </script>
    <script>
      // 客户端路由兜底：导航后页面内容与 URL 不一致时强制整页刷新，
      // 防止个别浏览器（或返回键场景）下路由交换失败导致页面空白。
      function ensurePageMatchesUrl() {
        // 404 页的 body 固定是 /404，而浏览器地址栏是被访问的缺失路径，
        // 二者天然不一致——若在此触发 reload 会陷入无限刷新，必须跳过。
        if (document.body?.hasAttribute('data-notfound')) return;
        const bodyPath = document.body?.getAttribute('data-path') ?? '';
        if (bodyPath && bodyPath !== window.location.pathname) {
          window.location.reload();
        }
      }
      // 交换前把当前 <html> 的类（主题、js 标记）带到新文档，
      // 避免客户端导航时深浅主题被重置
      document.addEventListener('astro:before-swap', (event) => {
        const currentClass = document.documentElement.getAttribute('class');
        if (currentClass) {
          event.newDocument.documentElement.setAttribute('class', currentClass);
        }
        // data-theme 记录的是「用户偏好」，也要一起带过去，
        // 否则切换页面后主题按钮的图标/无障碍标签会回到初始状态
        const currentTheme = document.documentElement.getAttribute('data-theme');
        if (currentTheme) {
          event.newDocument.documentElement.setAttribute('data-theme', currentTheme);
        }
      });
      window.addEventListener('popstate', () => {
        window.setTimeout(ensurePageMatchesUrl, 1200);
      });
      document.addEventListener('astro:page-load', () => {
        window.setTimeout(ensurePageMatchesUrl, 100);
      });
    </script>
  </body>
</html>
