---
import type { CollectionEntry } from 'astro:content';
import { formatDateShort } from '../utils/formatDate';
import { vtName } from '../utils/vtName';
import { tagSlug } from '../data/tags';
import { url } from '../utils/url';

interface Props {
  posts: CollectionEntry<'posts'>[];
  page: number;
  perPage?: number;
  /** 首页「推荐」标记：在列表内标出精选文章，而不是另起一个重复的列表 */
  featured?: string[];
  /** 入场序列的起始延迟（ms），用来和首页报头接上同一段编排 */
  riseBase?: number;
  /**
   * 年份标题的层级。它决定年份是 h2 还是 h3，标题跟着 +1。
   *
   * 默认 2：适用于 /page/N/ —— 那里有 `<h1>文章列表</h1>`，年份是它的下一级。
   * 首页传 3：首页是 h1 报头 → h2「文章」→ 年份属于「文章」的子分组，
   * 若也写 h2 就会和「文章」平级，语义上把年份当成了另一个顶层区块。
   */
  yearLevel?: 2 | 3;
}
const { posts, page, perPage = 4, featured = [], riseBase = 0, yearLevel = 2 } = Astro.props;

// 动态标签：Astro 里用大写变量名承载标签名字符串即可
const YearTag = `h${yearLevel}`;
const TitleTag = `h${yearLevel + 1}`;
const featuredSlugs = new Set(featured);

const totalPages = Math.max(1, Math.ceil(posts.length / perPage));
const start = (page - 1) * perPage;
const pagePosts = posts.slice(start, start + perPage);

// 当前页的文章按年份分组（与首页一致）
const byYear = new Map<number, CollectionEntry<'posts'>[]>();
for (const post of pagePosts) {
  const year = post.data.date.getFullYear();
  const group = byYear.get(year) ?? [];
  group.push(post);
  byYear.set(year, group);
}
const years = [...byYear.entries()];

const pageUrl = (n: number) => (n <= 1 ? url('/') : url(`/page/${n}/`));
const yearGroupReveal = (index: number) => `--reveal-delay: ${riseBase + Math.min(index * 80, 320)}ms`;

// 整页共用一条错峰序列：年份标题先出，随后每一行依次跟出。
// 逐行参与（而不是只给 .year-group 挂一个）是为了让动画覆盖到列表里
// 每一个可见元素——以前只挂容器，容器内的行没有各自的节奏。
// 延迟在 frontmatter 里一次算好，模板里只做查表（不引入渲染期自增副作用）。
const rowDelay = new Map<string, number>();
pagePosts.forEach((post, i) => {
  rowDelay.set(post.id, riseBase + 80 + Math.min(i * 45, 600));
});
---

<section class="archive" aria-label="文章列表">
  {
    years.map(([year, group], index) => (
      <div class="year-group">
        <YearTag class="year-label reveal" style={yearGroupReveal(index)}>{year}</YearTag>
        <ol class="post-list">
          {group.map((post) => (
            <li class="post-row reveal" style={`--reveal-delay: ${rowDelay.get(post.id)}ms`}>
              <a href={url(`/posts/${post.id}/`)}>
                <div class="post-when">
                  <time datetime={post.data.date.toISOString()}>
                    {formatDateShort(post.data.date)}
                  </time>
                  {featuredSlugs.has(post.id) && <span class="post-pick">推荐</span>}
                </div>
                <div>
                  <TitleTag class="post-row-title" transition:name={vtName(post.id)} transition:animate="none">
                    {post.data.title}
                  </TitleTag>
                  <p>{post.data.description}</p>
                </div>
              </a>
              {post.data.tags.length > 0 && (
                <ul class="tag-list">
                  {post.data.tags.map((tag) => (
                    <li>
                      <a class="tag" href={url(`/tags/${tagSlug(tag)}/`)}>#{tag}</a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))}
        </ol>
      </div>
    ))
  }

  {
    totalPages > 1 && (
      <nav
        class="pagination"
        id="pagination"
        aria-label="文章翻页"
        data-total={totalPages}
      >
        <a
          class="page-btn"
          data-dir="prev"
          data-vt-axis="x"
          data-vt-dir="prev"
          href={pageUrl(page - 1)}
          aria-disabled={page === 1 ? 'true' : undefined}
          tabindex={page === 1 ? '-1' : undefined}
        >
          ← 上一页
        </a>
        <ol class="page-numbers">
          {Array.from({ length: totalPages }, (_, i) => i + 1).map((n) => (
            <li>
              <a
                class="page-number"
                href={pageUrl(n)}
                data-page={n}
                data-vt-axis="x"
                data-vt-dir={n > page ? 'next' : 'prev'}
                aria-current={n === page ? 'page' : undefined}
              >
                {n}
              </a>
            </li>
          ))}
        </ol>
        <a
          class="page-btn"
          data-dir="next"
          data-vt-axis="x"
          data-vt-dir="next"
          href={pageUrl(page + 1)}
          aria-disabled={page === totalPages ? 'true' : undefined}
          tabindex={page === totalPages ? '-1' : undefined}
        >
          下一页 →
        </a>
      </nav>
    )
  }
</section>
