---
import { SITE } from '../consts';
import { Icon } from 'astro-icon/components';
import { url } from '../utils/url';

const path = Astro.url.pathname;
const home = url('/');
const isActive = (href: string) =>
  href === home ? path === home : path.startsWith(href);

const links = [
  { href: url('/'), label: '首页' },
  { href: url('/tags/'), label: '标签' },
  { href: url('/about/'), label: '关于' },
];
---

{/* transition:persist 必须写在原生元素上，写在 <Header /> 组件上会被静默忽略。
    persist 后页头不参与页面切换快照：整块页头（含搜索框）不再跟着闪，
    搜索框里已输入的内容与焦点也能跨页面保留。 */}
<header class="site-header" transition:persist="site-header">
  <div class="header-inner">
    <a class="wordmark" href={url('/')} aria-label={`${SITE.name} 首页`}>
      Az<span>ain</span>
    </a>
    <nav class="site-nav" aria-label="主导航">
      {links.map((link) => (
        <a
          href={link.href}
          aria-current={isActive(link.href) ? 'page' : undefined}
        >
          {link.label}
        </a>
      ))}
    </nav>
    <div class="header-actions">
      <div class="header-search" id="header-search">
        <Icon name="magnifying-glass" class="header-search-icon" />
        <input
          class="header-search-input"
          type="text"
          placeholder="搜索文章…"
          autocomplete="off"
          aria-label="站内搜索"
          role="combobox"
          aria-expanded="false"
          aria-autocomplete="list"
          aria-haspopup="listbox"
          aria-controls="search-popover-list"
        />
        {/* 搜索状态播报区。必须放在 .search-popover **之外**：弹层收起时是
            display:none，live region 在其中不会进入可访问性树，也就不会播报。
            .sr-only 保证它不可见但不脱离可访问性树。 */}
        <p class="sr-only" id="search-announce" aria-live="polite" aria-atomic="true"></p>
        <div class="search-popover" id="search-popover">
          <p class="search-popover-empty" hidden>没有找到相关文章</p>
          <ul
            class="search-popover-list"
            id="search-popover-list"
            role="listbox"
            aria-label="搜索结果"
            hidden
          ></ul>
          <a class="search-popover-more" href={url('/search/')} hidden></a>
        </div>
      </div>
      <a
        class="header-search-link"
        href={url('/search/')}
        aria-label="搜索"
        title="搜索"
      >
        <Icon name="magnifying-glass" />
      </a>
      <button
        class="theme-toggle"
        id="theme-toggle"
        type="button"
        aria-label="切换主题（当前：跟随系统）"
        title="主题：跟随系统"
      >
        <Icon name="sun" class="icon-sun" />
        <Icon name="moon" class="icon-moon" />
        <Icon name="monitor" class="icon-monitor" />
      </button>
    </div>
  </div>
</header>

<script>
  import {
    announce,
    buildIndex,
    searchIndex,
    highlight,
    formatDateCn,
    type PostIndex,
  } from '../scripts/search';
  import { onPageLoad } from '../scripts/lifecycle';
  import { url } from '../utils/url';
  import { vtName } from '../utils/vtName';

  let index: PostIndex[] = [];
  let indexPromise: Promise<PostIndex[]> | null = null;

  /**
   * 按需加载搜索索引。
   *
   * 此前在模块顶层无条件调用 buildIndex()，而页头出现在**每一个**页面上，
   * 于是连 /about/ 与 404 页都会下载整个索引（gzip 约 22.4 KB，占 /about/
   * 该页传输的 13%，且随文章数线性增长）——绝大多数访问者从未用过搜索。
   * 改为首次聚焦或输入时才发起；buildIndex 自身已做 Promise 缓存，
   * 这里再加一层是为了拿到"加载中"的直接句柄，避免重复触发。
   */
  function ensureIndex(): Promise<PostIndex[]> {
    if (!indexPromise) {
      indexPromise = buildIndex().then((data) => {
        index = data;
        return data;
      });
    }
    return indexPromise;
  }

  type ThemePref = 'light' | 'dark' | 'system';
  const THEME_ORDER: ThemePref[] = ['light', 'dark', 'system'];
  const THEME_LABELS: Record<ThemePref, string> = {
    light: '浅色',
    dark: '深色',
    system: '跟随系统',
  };

  /** 读取当前偏好：没选过或值非法都按 system 处理 */
  function currentPref(): ThemePref {
    const saved = localStorage.getItem('theme');
    return saved === 'light' || saved === 'dark' ? saved : 'system';
  }

  function isDark(pref: ThemePref): boolean {
    return (
      pref === 'dark' ||
      (pref === 'system' &&
        window.matchMedia('(prefers-color-scheme: dark)').matches)
    );
  }

  /** 按钮无障碍文本反映「当前偏好」，而不是当前实际明暗 */
  function syncToggleLabel(pref: ThemePref): void {
    const toggle = document.getElementById('theme-toggle');
    if (!toggle) return;
    const label = THEME_LABELS[pref];
    toggle.setAttribute('aria-label', `切换主题（当前：${label}）`);
    toggle.setAttribute('title', `主题：${label}`);
  }

  /**
   * 让 theme-color 与实际底色一致。
   *
   * 两处 meta 的 media 分支只认**系统**偏好；本站的偏好是 light/dark/system
   * 三态，用户显式选过之后可能与系统相反，那时 media 分支给出的就是错的颜色。
   * 这里按实际渲染出的 --bg 回写两处 meta —— 直接取值而不是再抄一份十六进制，
   * 保证与令牌同源、不会再次漂移。
   */
  function syncThemeColor(): void {
    // 必须读 **--bg 令牌**，不能读 body 的 computed backgroundColor：
    // body 上有 0.25s 的 background-color 过渡，切换主题后立刻取到的是
    // 过渡中的中间色，而过一会儿又不会再有第二次同步——实测 meta 会因此
    // 停在旧色（切到深色后 meta 仍是浅色）。自定义属性不参与过渡，
    // 取到的就是当前主题的真实底色，也保证与令牌同源。
    const bg = getComputedStyle(document.documentElement)
      .getPropertyValue('--bg')
      .trim();
    if (!bg) return;
    document
      .querySelectorAll('meta[name="theme-color"]')
      .forEach((m) => m.setAttribute('content', bg));
  }

  function applyTheme(pref: ThemePref): void {
    const root = document.documentElement;
    root.dataset.theme = pref;
    localStorage.setItem('theme', pref);
    root.classList.toggle('dark', isDark(pref));
    syncToggleLabel(pref);
    syncThemeColor();
  }

  // 系统主题监听只需要挂一次：MediaQueryList 不随页面切换重建，
  // 每次 initTheme 都 addEventListener 会越积越多
  let systemBound = false;

  /** 主题切换：三态循环 light → dark → system，独立于搜索框初始化 */
  function initTheme() {
    const toggle = document.getElementById('theme-toggle');
    if (!toggle || toggle.dataset.inited) return;
    toggle.dataset.inited = 'true';

    // 进入页面时先把无障碍标签与 theme-color 同步成真实偏好
    // （显式偏好可能与系统相反，此时 media 分支给的颜色是错的）
    syncToggleLabel(currentPref());
    syncThemeColor();

    toggle.addEventListener('click', () => {
      const next =
        THEME_ORDER[(THEME_ORDER.indexOf(currentPref()) + 1) % THEME_ORDER.length];
      applyTheme(next);
    });

    if (!systemBound) {
      systemBound = true;
      window
        .matchMedia('(prefers-color-scheme: dark)')
        .addEventListener('change', () => {
          // 只有 system 模式才需要实时跟随；用户显式选过就不该被系统覆盖
          if (currentPref() === 'system') applyTheme('system');
        });
    }
  }

  /** 每次页面加载/切换后重新绑定页头交互（页头节点会被重建） */
  function initHeader() {
    const container = document.getElementById('header-search');
    if (!container || container.dataset.inited) return;
    container.dataset.inited = 'true';

    const input = container.querySelector('input') as HTMLInputElement;
    const popover = document.getElementById('search-popover')!;
    const listEl = popover.querySelector('.search-popover-list') as HTMLUListElement;
    const emptyEl = popover.querySelector(
      '.search-popover-empty',
    ) as HTMLParagraphElement;
    const moreEl = popover.querySelector(
      '.search-popover-more',
    ) as HTMLAnchorElement;
    const announceEl = document.getElementById('search-announce');
    let activeIndex = -1;

    /** 播报结果条数；无结果时也要出声，否则读屏用户不知道发生了什么 */
    function announceResults(count: number, query: string): void {
      announce(
        announceEl,
        count === 0
          ? `没有找到与"${query}"相关的文章`
          : `找到 ${count} 篇文章`,
      );
    }

    function syncActiveDescendant() {
      const items = listEl.querySelectorAll('.search-popover-item');
      const id = activeIndex >= 0 ? items[activeIndex]?.id : undefined;
      if (id) input.setAttribute('aria-activedescendant', id);
      else input.removeAttribute('aria-activedescendant');
      items.forEach((el, i) => {
        const selected = i === activeIndex ? 'true' : 'false';
        el.setAttribute('aria-selected', selected);
      });
    }

    function closePopover() {
      popover.classList.remove('open');
      input.setAttribute('aria-expanded', 'false');
      activeIndex = -1;
      syncActiveDescendant();
    }

    async function render(query: string) {
      // 索引此刻可能仍在路上：先等它就绪，否则会把"还没加载完"误报成"没有结果"
      await ensureIndex();
      // 等待期间输入可能已被清空或改写，此时这次渲染已过期
      if (input.value.trim() !== query) return;
      const items = searchIndex(index, query);
      listEl.replaceChildren();
      moreEl.hidden = true;
      activeIndex = -1;

      if (items.length === 0) {
        emptyEl.hidden = false;
        listEl.hidden = true;
        announceResults(0, query);
      } else {
        emptyEl.hidden = true;
        listEl.hidden = false;
        announceResults(items.length, query);
        for (const [i, { post }] of items.slice(0, 6).entries()) {
          const li = document.createElement('li');
          li.setAttribute('role', 'presentation');
          const link = document.createElement('a');
          link.className = 'search-popover-item';
          link.id = `search-opt-${i}`;
          link.setAttribute('role', 'option');
          link.setAttribute('aria-selected', 'false');
          link.href = url(`/posts/${post.slug}/`);

          const title = document.createElement('span');
          title.className = 'search-popover-title';
          title.style.viewTransitionName = vtName(post.slug);
          highlight(title, post.title, query);

          const meta = document.createElement('span');
          meta.className = 'search-popover-meta';
          meta.textContent = `${formatDateCn(post.date)}${
            post.tags.length ? ` · ${post.tags.join(' / ')}` : ''
          }`;

          link.append(title, meta);
          li.appendChild(link);
          listEl.appendChild(li);
        }
        const searchUrl = new URL(url('/search/'), window.location.origin);
        searchUrl.searchParams.set('q', query);
        moreEl.href = searchUrl.toString();
        moreEl.textContent = `查看全部 ${items.length} 条结果`;
        moreEl.hidden = false;
      }
      popover.classList.add('open');
      input.setAttribute('aria-expanded', 'true');
      syncActiveDescendant();
    }

    let timer: number | undefined;
    input.addEventListener('input', () => {
      window.clearTimeout(timer);
      const q = input.value.trim();
      if (!q) {
        closePopover();
        // 清空后播报状态复位，避免读屏用户仍以为停留在上一次的结果数上
        announce(announceEl, '');
        return;
      }
      timer = window.setTimeout(() => void render(q), 120);
    });

    input.addEventListener('focus', () => {
      // 聚焦即预取：用户开始输入时索引通常已就绪，兼顾"不浪费字节"与"首次搜索不慢"
      void ensureIndex();
      if (input.value.trim()) void render(input.value.trim());
    });

    // 外部（点击别处 / 页面切换）请求关闭时，同样经过 closePopover，
    // 保证 .open 与 aria-expanded / aria-activedescendant 一起复位
    container.addEventListener('search:close', () => closePopover());

    input.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        input.value = '';
        closePopover();
        return;
      }
      if (event.key === 'Enter') {
        const items = listEl.querySelectorAll('.search-popover-item');
        if (activeIndex >= 0 && items[activeIndex]) {
          (items[activeIndex] as HTMLAnchorElement).click();
          return;
        }
        // 直接回车时索引可能尚未加载完，必须等它，否则会误跳到搜索页
        const q = input.value.trim();
        void ensureIndex().then(() => {
          const hits = searchIndex(index, q);
          if (hits.length) {
            window.location.href = url(`/posts/${hits[0].post.slug}/`);
          } else {
            const searchUrl = new URL(url('/search/'), window.location.origin);
            searchUrl.searchParams.set('q', q);
            window.location.href = searchUrl.toString();
          }
        });
        return;
      }
      if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
        const items = listEl.querySelectorAll('.search-popover-item');
        if (!items.length) return;
        event.preventDefault();
        if (event.key === 'ArrowDown') {
          activeIndex = Math.min(activeIndex + 1, items.length - 1);
        } else {
          activeIndex = Math.max(activeIndex - 1, 0);
        }
        items.forEach((el, i) => el.classList.toggle('active', i === activeIndex));
        (items[activeIndex] as HTMLElement).scrollIntoView({ block: 'nearest' });
        syncActiveDescendant();
      }
    });
  }

  // 客户端切换页面后，保持导航高亮与当前页一致
  function updateNav() {
    const path = window.location.pathname;
    const home = url('/');
    document.querySelectorAll('.site-nav a').forEach((a) => {
      const href = a.getAttribute('href') || home;
      const active = href === home ? path === home : path.startsWith(href);
      if (active) a.setAttribute('aria-current', 'page');
      else a.removeAttribute('aria-current');
    });
  }

  let outsideBound = false;
  function bindOutsideClick() {
    if (outsideBound) return;
    outsideBound = true;
    document.addEventListener('pointerdown', (event) => {
      const container = document.getElementById('header-search');
      if (!container || container.contains(event.target as Node)) return;
      // 只移除 .open 会让 aria-expanded 停在 "true"（读屏用户以为面板还开着）。
      // 统一走 closePopover() —— 那是 initHeader 闭包里的同一个函数，
      // 这里通过派发一个"请求关闭"的自定义事件来调用它，避免复制一份关闭逻辑。
      container.dispatchEvent(new CustomEvent('search:close', { bubbles: false }));
    });
  }

  /**
   * Ctrl/Cmd + K 打开搜索。
   * 绑定在 document 上（客户端路由切换后 document 对象保留，只需绑一次），
   * 但每次触发都重新查询当前页头的输入框——页头节点每页都会重建。
   */
  let shortcutBound = false;
  function bindSearchShortcut() {
    if (shortcutBound) return;
    shortcutBound = true;
    document.addEventListener('keydown', (event) => {
      if (!(event.metaKey || event.ctrlKey)) return;
      if (event.key.toLowerCase() !== 'k') return;
      // 浏览器默认会把 Ctrl/Cmd + K 送给地址栏，必须拦下来
      event.preventDefault();

      const input =
        document.querySelector<HTMLInputElement>('.header-search-input');
      // 窄屏下页头搜索框被隐藏（getClientRects 为空），此时改跳搜索页
      if (input && input.getClientRects().length > 0) {
        input.focus();
        input.select();
        // 已有关键词时顺带把结果面板带出来
        if (input.value.trim()) input.dispatchEvent(new Event('input'));
      } else {
        window.location.href = url('/search/');
      }
    });
  }

  // 页头加了 transition:persist：DOM 不再随导航重建，所以不必每次都重新绑定，
  // 但**必须**在每次导航后重新同步"当前页高亮"与主题按钮的无障碍标签
  // （服务端渲染出来的 aria-current 属于上一个页面）。
  onPageLoad(() => {
    initHeader();
    initTheme();
    updateNav();
    bindOutsideClick();
    bindSearchShortcut();
    // 上次导航若停在搜索弹层上，切页后要收起来，免得残留在新页面上。
    // 走同一个关闭路径，否则 aria-expanded 会残留为 true（实测）。
    const searchContainer = document.getElementById('header-search');
    if (searchContainer) {
      searchContainer.dispatchEvent(new CustomEvent('search:close', { bubbles: false }));
    }
  });
</script>
