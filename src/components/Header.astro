---
import { SITE } from '../consts';
import Icon from './Icon.astro';

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);

const links = [
  { href: '/', label: '首页' },
  { href: '/tags/', label: '标签' },
  { href: '/about/', label: '关于' },
];
---

<header class="site-header">
  <div class="header-inner">
    <button
      class="back-button"
      id="back-button"
      type="button"
      aria-label="返回上一页"
      title="返回上一页"
      hidden
    >
      <Icon name="arrow-left" />
    </button>
    <a class="wordmark" href="/" aria-label="{SITE.name} 首页">
      Az<span>ain</span>
    </a>
    <nav class="site-nav" aria-label="主导航">
      {links.map((link) => (
        <a
          href={link.href}
          aria-current={isActive(link.href) ? 'page' : undefined}
        >
          {link.label}
        </a>
      ))}
    </nav>
    <div class="header-actions">
      <div class="header-search" id="header-search">
        <Icon name="magnifying-glass" class="header-search-icon" />
        <input
          class="header-search-input"
          type="text"
          placeholder="搜索文章…"
          autocomplete="off"
          aria-label="站内搜索"
          aria-controls="search-popover"
        />
        <div
          class="search-popover"
          id="search-popover"
          role="listbox"
          aria-label="搜索结果"
        >
          <p class="search-popover-empty" hidden>没有找到相关文章</p>
          <ul class="search-popover-list" hidden></ul>
          <a class="search-popover-more" href="/search/" hidden></a>
        </div>
      </div>
      <a
        class="header-search-link"
        href="/search/"
        aria-label="搜索"
        title="搜索"
      >
        <Icon name="magnifying-glass" />
      </a>
      <button
        class="theme-toggle"
        id="theme-toggle"
        type="button"
        aria-label="切换深浅主题"
      >
        <Icon name="sun" class="icon-sun" />
        <Icon name="moon" class="icon-moon" />
      </button>
    </div>
  </div>
</header>

<script>
  import {
    buildIndex,
    searchIndex,
    highlight,
    formatDateCn,
    type PostIndex,
  } from '../scripts/search';
  import { vtName } from '../utils/vtName';

  let index: PostIndex[] = [];

  buildIndex().then((data) => {
    index = data;
  });

  /** 每次页面加载/切换后重新绑定页头交互（页头节点会被重建） */
  function initHeader() {
    const container = document.getElementById('header-search');
    if (!container || container.dataset.inited) return;
    container.dataset.inited = 'true';

    const input = container.querySelector('input') as HTMLInputElement;
    const popover = document.getElementById('search-popover')!;
    const listEl = popover.querySelector('.search-popover-list') as HTMLUListElement;
    const emptyEl = popover.querySelector(
      '.search-popover-empty',
    ) as HTMLParagraphElement;
    const moreEl = popover.querySelector(
      '.search-popover-more',
    ) as HTMLAnchorElement;
    let activeIndex = -1;

    function closePopover() {
      popover.classList.remove('open');
      activeIndex = -1;
    }

    function render(query: string) {
      const items = searchIndex(index, query);
      listEl.replaceChildren();
      moreEl.hidden = true;
      activeIndex = -1;

      if (items.length === 0) {
        emptyEl.hidden = false;
        listEl.hidden = true;
      } else {
        emptyEl.hidden = true;
        listEl.hidden = false;
        for (const { post } of items.slice(0, 6)) {
          const li = document.createElement('li');
          const link = document.createElement('a');
          link.className = 'search-popover-item';
          link.href = `/posts/${post.slug}/`;

          const title = document.createElement('span');
          title.className = 'search-popover-title';
          title.style.viewTransitionName = vtName(post.slug);
          highlight(title, post.title, query);

          const meta = document.createElement('span');
          meta.className = 'search-popover-meta';
          meta.textContent = `${formatDateCn(post.date)}${
            post.tags.length ? ` · ${post.tags.join(' / ')}` : ''
          }`;

          link.append(title, meta);
          li.appendChild(link);
          listEl.appendChild(li);
        }
        const url = new URL('/search/', window.location.origin);
        url.searchParams.set('q', query);
        moreEl.href = url.toString();
        moreEl.textContent = `查看全部 ${items.length} 条结果`;
        moreEl.hidden = false;
      }
      popover.classList.add('open');
    }

    let timer: number | undefined;
    input.addEventListener('input', () => {
      window.clearTimeout(timer);
      const q = input.value.trim();
      if (!q) {
        closePopover();
        return;
      }
      timer = window.setTimeout(() => render(q), 120);
    });

    input.addEventListener('focus', () => {
      if (input.value.trim()) render(input.value.trim());
    });

    input.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        input.value = '';
        closePopover();
        return;
      }
      if (event.key === 'Enter') {
        const items = listEl.querySelectorAll('.search-popover-item');
        if (activeIndex >= 0 && items[activeIndex]) {
          (items[activeIndex] as HTMLAnchorElement).click();
          return;
        }
        const hits = searchIndex(index, input.value.trim());
        if (hits.length) {
          window.location.href = `/posts/${hits[0].post.slug}/`;
        } else {
          const url = new URL('/search/', window.location.origin);
          url.searchParams.set('q', input.value.trim());
          window.location.href = url.toString();
        }
        return;
      }
      if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
        const items = listEl.querySelectorAll('.search-popover-item');
        if (!items.length) return;
        event.preventDefault();
        if (event.key === 'ArrowDown') {
          activeIndex = Math.min(activeIndex + 1, items.length - 1);
        } else {
          activeIndex = Math.max(activeIndex - 1, 0);
        }
        items.forEach((el, i) => el.classList.toggle('active', i === activeIndex));
        (items[activeIndex] as HTMLElement).scrollIntoView({ block: 'nearest' });
      }
    });

    const toggle = document.getElementById('theme-toggle');
    toggle?.addEventListener('click', () => {
      const dark = document.documentElement.classList.toggle('dark');
      localStorage.setItem('theme', dark ? 'dark' : 'light');
    });

    // 左上角返回按钮：非首页显示；有站内历史则返回上一页，否则回首页
    const backBtn = document.getElementById('back-button');
    if (backBtn) {
      backBtn.hidden = window.location.pathname === '/';
      backBtn.dataset.hasPrev = String((history.state?.index ?? 0) > 0);
      backBtn.addEventListener('click', () => {
        if (backBtn.dataset.hasPrev === 'true') {
          history.back();
        } else {
          const homeLink = document.querySelector('.wordmark') as HTMLAnchorElement | null;
          if (homeLink) homeLink.click();
          else window.location.href = '/';
        }
      });
    }
  }

  // 客户端切换页面后，保持导航高亮与当前页一致
  function updateNav() {
    const path = window.location.pathname;
    document.querySelectorAll('.site-nav a').forEach((a) => {
      const href = a.getAttribute('href') || '/';
      const active = href === '/' ? path === '/' : path.startsWith(href);
      if (active) a.setAttribute('aria-current', 'page');
      else a.removeAttribute('aria-current');
    });
  }

  document.addEventListener('pointerdown', (event) => {
    const container = document.getElementById('header-search');
    if (container && !container.contains(event.target as Node)) {
      document.getElementById('search-popover')?.classList.remove('open');
    }
  });

  document.addEventListener('astro:page-load', () => {
    initHeader();
    updateNav();
  });
</script>
